# ============================================================
#  HyAuth-Agent .gitignore
#  只提交「源码 / 文档 / 自检脚本」；构建产物、依赖缓存、第三方工具、运行时文件一律不进仓库。
# ============================================================

# ---------- 构建产物 ----------
target/
build/
out/
*.class

# 发布用的 jar 由 GitHub Actions 构建并挂到 Release，不进仓库
*.jar
*.war

# ---------- 依赖缓存 ----------
.m2repo/
verify/libs/

# ---------- 可选的「免安装 Maven」 ----------
# build.bat / build.sh 会优先用 PATH 里的 mvn，找不到才用 tools\apache-maven-3.9.9。
# 想把这个约 11MB 的工具链也放进仓库（方便"零安装构建"）→ 删掉下面这一行。
tools/

# ---------- 服务端 / 运行时文件（万一在仓库目录里直接开服也别提交） ----------
# ★ 注意：目录规则前面必须加斜杠锚定到仓库根！
#   否则 `world/` 会匹配到任意层级的 world 目录 —— 自检替身里正好有
#   verify/lag/net/minecraft/world/entity/Entity.java 与 …/world/level/chunk/LevelChunk.java，
#   那两个文件会被静默忽略：本地有文件所以自检照样过，CI 检出后却缺文件、javac 直接编译失败。
server.jar
eula.txt
server.properties
littleskin_config.json
banned-ips.json
banned-players.json
ops.json
whitelist.json
usercache.json
/logs/
/crash-reports/
/world/
/world_nether/
/world_the_end/
/libraries/
/versions/

# 自检脚手架里的替身目录必须提交（再兜一层，防止将来又加上没锚定的目录规则）
!verify/lag/net/minecraft/world/
!verify/lag/net/minecraft/world/**

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
*.swp

# ---------- 操作系统 ----------
Thumbs.db
Desktop.ini
.DS_Store

# ---------- 临时文件 ----------
*.tmp
*.log
